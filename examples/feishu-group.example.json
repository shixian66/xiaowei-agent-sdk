  "send_timeout_seconds": 10,
  "connect_timeout_seconds": 30,
  "stop_timeout_seconds": 10,
  "group": {
    "chat_id": "oc_replace_with_chat_id",
    "tools": [
      "local/describe_table",
      "local/describe_table_layout",
      "local/explain_query",
      "local/list_tables",
      "local/run_readonly_query"
    ],
    "member_page_size": 100,
    "member_max_pages": 5,
    "member_timeout_seconds": 10,
    "max_waiting": 4,
    "max_wait_seconds": 600,
    "wait_check_seconds": 5
  }
