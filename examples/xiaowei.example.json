{
  "storage": {
    "database_url_ref": "env:XW_DATABASE_URL",
    "digest_key_ref": "env:XW_DIGEST_KEY",
    "evidence_retention_seconds": 604800,
    "request_retention_seconds": 604800,
    "max_answer_bytes": 65536
  },
  "model": {
    "profile_id": "vertex-main",
    "provider": "vertex",
    "model": "gemini-3-flash-preview",
    "api_key_ref": "env:XW_MODEL_API_KEY",
    "request_timeout_seconds": 120,
    "max_output_tokens": 16384,
    "max_request_bytes": 1000000,
    "max_response_bytes": 1000000,
    "data_policy_id": "example-policy",
    "reasoning_effort": null
  },
  "data_policy": {
    "input": {
      "max_bytes": 16000,
      "forbidden_patterns": []
    },
    "model_tools": [
      "local/list_databases",
      "local/show_create_table",
      "local/describe_table",
      "local/describe_table_layout",
      "local/explain_query",
      "local/list_slow_queries",
      "local/list_tables",
      "local/run_readonly_query"
    ]
  },
  "session_limits": {
    "max_history_turns": 20,
    "max_history_bytes": 400000,
    "retention_seconds": 604800
  },
  "budget": {
    "max_turns": 16,
    "max_tool_calls": 16,
    "timeout_seconds": 300,
    "max_scope_checks": 2048
  },
  "max_concurrent_turns": 4,
  "targets": [
    {
      "type": "starrocks",
      "description": "公司 fat StarRocks 报表集群",
      "business_context": null,
      "starrocks": {
        "target_id": "fat",
        "host": "172.31.255.56",
        "port": 9030,
        "database": "data_center",
        "tls": false,
        "tls_ca_file": null,
        "user": "xiaowei_ro",
        "password_ref": "env:XW_STARROCKS_PASSWORD",
        "connect_timeout_seconds": 5,
        "query_timeout_seconds": 60,
        "client_timeout_seconds": 65,
        "pool_size": 4,
        "time_zone": "Asia/Shanghai",
        "query_mem_limit_bytes": 1073741824,
        "max_result_bytes": 200000,
        "max_value_bytes": 4000,
        "max_ddl_bytes": 64000,
        "max_plan_lines": 500,
        "audit": {
          "database": "starrocks_audit_db__",
          "table": "starrocks_audit_tbl__",
          "time_zone": "Asia/Shanghai",
          "stmt_limit": 1048576,
          "max_window_minutes": 10080,
          "max_rows": 20,
          "candidate_rows": 200,
          "candidate_bytes": 8388608
        },
        "policy": {
          "allowed_functions": [
            "COUNT",
            "SUM",
            "AVG",
            "MAX",
            "MIN",
            "ROUND",
            "ABS",
            "FLOOR",
            "CEIL",
            "COALESCE",
            "NULLIF",
            "IF",
            "CAST",
            "TS_OR_DS_TO_DATE",
            "TS_OR_DS_TO_TIMESTAMP",
            "TIME_TO_STR",
            "TO_DATE",
            "DATE_ADD",
            "DATE_SUB",
            "DATEDIFF",
            "TIMESTAMP_TRUNC",
            "YEAR",
            "MONTH",
            "DAY",
            "HOUR",
            "WEEK",
            "NOW",
            "CURRENT_DATE",
            "UNIX_TIMESTAMP",
            "UNIX_TO_TIME",
            "CONCAT",
            "SUBSTRING",
            "LOWER",
            "UPPER",
            "LENGTH",
            "TRIM",
            "REPLACE",
            "APPROX_DISTINCT",
            "GROUP_CONCAT",
            "PERCENTILE_APPROX",
            "ROW_NUMBER",
            "RANK",
            "DENSE_RANK",
            "LAG",
            "LEAD"
          ],
          "max_rows": 200,
          "max_sql_bytes": 16000,
          "max_result_columns": 50
        },
        "schema_limits": {
          "refresh_seconds": 300,
          "max_age_seconds": 900,
          "refresh_timeout_seconds": 120,
          "max_objects": 1000,
          "max_columns": 30000,
          "max_bytes": 4000000,
          "max_comment_chars": 200
        }
      }
    }
  ],
  "projection_bytes": {
    "model": 400000,
    "session": 400000,
    "web": 400000,
    "feishu": 400000
  },
  "access": {
    "policy_version": "v1",
    "grants": {
      "local-operator": [
        "local/list_databases",
        "local/show_create_table",
        "local/describe_table",
        "local/describe_table_layout",
        "local/explain_query",
        "local/list_slow_queries",
        "local/list_tables",
        "local/run_readonly_query"
      ]
    }
  },
  "web": {
    "operator_id": "local-operator",
    "allowed_origins": [
      "http://127.0.0.1:8501",
      "http://172.20.0.8:8501"
    ],
    "secure_cookie": false,
    "max_body_bytes": 65536
  },
  "listen_host": "127.0.0.1",
  "listen_port": 8501,
  "feishu": null,
  "shutdown_timeout_seconds": 30,
  "lock_check_seconds": 5
}
