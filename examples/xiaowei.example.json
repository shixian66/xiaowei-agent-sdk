{
  "storage": {
    "database_url_ref": "env:XW_DATABASE_URL",
    "digest_key_ref": "env:XW_DIGEST_KEY",
    "evidence_retention_seconds": 604800,
    "request_retention_seconds": 604800,
    "max_answer_bytes": 65536
  },
  "model": {
    "profile_id": "vertex-main",
    "provider": "vertex",
    "model": "replace-with-approved-vertex-model",
    "api_key_ref": "env:XW_MODEL_API_KEY",
    "request_timeout_seconds": 60,
    "max_output_tokens": 4096,
    "max_request_bytes": 1000000,
    "max_response_bytes": 1000000,
    "data_policy_id": "example-policy",
    "reasoning_effort": null
  },
  "data_policy": {
    "input": {
      "max_bytes": 4000,
      "forbidden_patterns": []
    },
    "model_tools": [
      "local/list_databases",
      "local/describe_table",
      "local/describe_table_layout",
      "local/explain_query",
      "local/list_slow_queries",
      "local/list_tables",
      "local/run_readonly_query"
    ]
  },
  "session_limits": {
    "max_history_turns": 20,
    "max_history_bytes": 400000,
    "retention_seconds": 604800
  },
  "budget": {
    "max_turns": 8,
    "max_tool_calls": 6,
    "timeout_seconds": 120,
    "max_scope_checks": 1024
  },
  "max_concurrent_turns": 4,
  "targets": [
    {
      "type": "starrocks",
      "description": "<集群用途，交给模型选择集群>",
      "business_context": null,
      "starrocks": {
        "target_id": "warehouse",
        "host": "<StarRocks FE 地址>",
        "port": 9030,
        "database": "<默认 database>",
        "tls": true,
        "tls_ca_file": null,
        "user": "<只读账号>",
        "password_ref": "env:XW_STARROCKS_PASSWORD",
        "connect_timeout_seconds": 5,
        "query_timeout_seconds": 30,
        "client_timeout_seconds": 35,
        "pool_size": 4,
        "time_zone": "Asia/Shanghai",
        "query_mem_limit_bytes": 1073741824,
        "max_result_bytes": 200000,
        "max_value_bytes": 4000,
        "max_plan_lines": 500,
        "audit": {
          "database": "starrocks_audit_db__",
          "table": "starrocks_audit_tbl__",
          "time_zone": "Asia/Shanghai",
          "stmt_limit": 1048576,
          "max_window_minutes": 1440,
          "max_rows": 20,
          "candidate_rows": 200,
          "candidate_bytes": 2097152
        },
        "policy": {
          "allowed_functions": [
            "COUNT",
            "SUM"
          ],
          "max_rows": 200,
          "max_sql_bytes": 8000,
          "max_result_columns": 50
        },
        "schema_limits": {
          "refresh_seconds": 60,
          "max_age_seconds": 300,
          "refresh_timeout_seconds": 10,
          "max_objects": 1000,
          "max_columns": 30000,
          "max_bytes": 4000000,
          "max_comment_chars": 200
        }
      }
    }
  ],
  "projection_bytes": {
    "model": 400000,
    "session": 400000,
    "web": 400000,
    "feishu": 400000
  },
  "access": {
    "policy_version": "v1",
    "grants": {
      "local-operator": [
        "local/list_databases",
        "local/describe_table",
        "local/describe_table_layout",
        "local/explain_query",
        "local/list_slow_queries",
        "local/list_tables",
        "local/run_readonly_query"
      ]
    }
  },
  "web": {
    "operator_id": "local-operator",
    "secure_cookie": false,
    "max_body_bytes": 65536
  },
  "listen_host": "127.0.0.1",
  "listen_port": 8501,
  "feishu": null,
  "shutdown_timeout_seconds": 30,
  "lock_check_seconds": 5
}
