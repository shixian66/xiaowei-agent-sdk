{
  "storage": {
    "database_url_ref": "env:XW_DATABASE_URL",
    "digest_key_ref": "env:XW_DIGEST_KEY",
    "evidence_retention_seconds": 604800,
    "request_retention_seconds": 604800,
    "max_answer_bytes": 65536
  },
  "model": {
    "profile_id": "example-openai",
    "provider": "openai",
    "base_url": "https://api.openai.com/v1",
    "api_mode": "responses",
    "model": "<获准的模型 ID>",
    "api_key_ref": "env:XW_MODEL_API_KEY",
    "output_mode": "json_schema",
    "request_timeout_seconds": 60,
    "max_output_tokens": 4096,
    "max_request_bytes": 1000000,
    "max_response_bytes": 1000000,
    "data_policy_id": "example-policy",
    "reasoning_effort": null
  },
  "data_policy": {
    "input": {
      "max_bytes": 4000,
      "forbidden_patterns": []
    },
    "model_tools": [
      "local/describe_table",
      "local/explain_query",
      "local/list_tables",
      "local/run_readonly_query"
    ]
  },
  "session_limits": {
    "max_history_turns": 20,
    "max_history_bytes": 400000,
    "retention_seconds": 604800
  },
  "budget": {
    "max_turns": 8,
    "max_tool_calls": 6,
    "timeout_seconds": 120
  },
  "max_concurrent_turns": 4,
  "business_context": null,
  "starrocks": {
    "target_id": "warehouse",
    "host": "<StarRocks FE 地址>",
    "port": 9030,
    "database": "<默认 database>",
    "tls": true,
    "tls_ca_file": null,
    "user": "<只读账号>",
    "password_ref": "env:XW_STARROCKS_PASSWORD",
    "connect_timeout_seconds": 5,
    "query_timeout_seconds": 30,
    "client_timeout_seconds": 35,
    "pool_size": 4,
    "time_zone": "Asia/Shanghai",
    "query_mem_limit_bytes": 1073741824,
    "max_result_bytes": 200000,
    "max_value_bytes": 4000,
    "max_plan_lines": 500,
    "policy": {
      "target_id": "warehouse",
      "default_database": "<默认 database>",
      "allowed_objects": [
        "<表或视图>"
      ],
      "allowed_columns": {
        "<表或视图>": [
          "<列>"
        ]
      },
      "allowed_functions": [
        "COUNT",
        "SUM"
      ],
      "max_rows": 200,
      "max_sql_bytes": 8000
    }
  },
  "projection_bytes": {
    "model": 400000,
    "session": 400000,
    "web": 400000,
    "feishu": 400000
  },
  "access": {
    "policy_version": "v1",
    "grants": {
      "local-operator": [
        "local/describe_table",
        "local/explain_query",
        "local/list_tables",
        "local/run_readonly_query"
      ]
    }
  },
  "web": {
    "operator_id": "local-operator",
    "allowed_origins": [
      "http://127.0.0.1:8501"
    ],
    "secure_cookie": false,
    "max_body_bytes": 65536
  },
  "listen_host": "127.0.0.1",
  "listen_port": 8501,
  "feishu": null,
  "shutdown_timeout_seconds": 30,
  "lock_check_seconds": 5
}
