{
  "type": "tidb",
  "description": "TiDB 生产 A；监控源 shared-prom / shared-grafana，cluster=\"tidb-prod-a\"；app 为配置默认业务库",
  "business_context": null,
  "tidb": {
    "target_id": "tidb-prod-a",
    "host": "tidb-prod-a.example.internal",
    "port": 4000,
    "database": "app",
    "tls": true,
    "tls_ca_file": null,
    "user": "xiaowei_ro",
    "password_ref": "env:XW_TIDB_A_PASSWORD",
    "connect_timeout_seconds": 5,
    "query_timeout_seconds": 60,
    "client_timeout_seconds": 65,
    "pool_size": 4,
    "time_zone": "Asia/Shanghai",
    "query_mem_limit_bytes": 1073741824,
    "max_result_bytes": 200000,
    "max_value_bytes": 4000,
    "max_ddl_bytes": 64000,
    "max_plan_lines": 500,
    "policy": {
      "allowed_functions": [
        "COUNT",
        "SUM",
        "AVG",
        "MAX",
        "MIN",
        "ROUND",
        "ABS",
        "FLOOR",
        "CEIL",
        "COALESCE",
        "NULLIF",
        "IF",
        "CAST",
        "TS_OR_DS_TO_DATE",
        "TS_OR_DS_TO_TIMESTAMP",
        "TIME_TO_STR",
        "TO_DATE",
        "DATE_ADD",
        "DATE_SUB",
        "DATEDIFF",
        "TIMESTAMP_TRUNC",
        "YEAR",
        "MONTH",
        "DAY",
        "HOUR",
        "WEEK",
        "NOW",
        "CURRENT_DATE",
        "UNIX_TIMESTAMP",
        "UNIX_TO_TIME",
        "CONCAT",
        "SUBSTRING",
        "LOWER",
        "UPPER",
        "LENGTH",
        "TRIM",
        "REPLACE",
        "APPROX_DISTINCT",
        "GROUP_CONCAT",
        "PERCENTILE_APPROX",
        "ROW_NUMBER",
        "RANK",
        "DENSE_RANK",
        "LAG",
        "LEAD"
      ],
      "max_rows": 200,
      "max_sql_bytes": 16000,
      "max_result_columns": 50
    },
    "schema_limits": {
      "refresh_seconds": 300,
      "max_age_seconds": 900,
      "refresh_timeout_seconds": 120,
      "max_objects": 1000,
      "max_columns": 30000,
      "max_bytes": 4000000,
      "max_comment_chars": 200
    }
  }
}
