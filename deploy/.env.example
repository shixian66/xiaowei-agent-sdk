# 首次安装时复制为 .env 并 chmod 600。升级不得用模板覆盖现有 .env。
# 包含空格、#、$ 或引号的值使用 Compose 单引号语法；不要把真实值提交到 Git。

# 操作者可调整的全部部署参数
XW_WEB_PORT=8501
XW_STOP_GRACE_SECONDS=120
XW_CONFIG_FILE=./xiaowei.json
XW_CERTS_DIR=./certs
XW_LOG_MAX_SIZE=10m
XW_LOG_MAX_FILES=3
XW_PROJECT_NAME=xiaowei
XW_PG_VOLUME=xiaowei-pgdata

# PostgreSQL 初始化值。XW_DATABASE_URL 的密码必须按 URI 规则编码并与下值一致。
XW_POSTGRES_DB=xiaowei
XW_POSTGRES_USER=xiaowei
XW_POSTGRES_PASSWORD='<生成并安全保存的 PostgreSQL 密码>'
XW_DATABASE_URL='postgresql+asyncpg://xiaowei:<URI 编码后的密码>@postgres:5432/xiaowei'

# 应用安全引用。XW_DIGEST_KEY 与数据库必须成对备份，升级时不得重新生成。
XW_DIGEST_KEY='<生成并安全保存的摘要密钥>'
XW_MODEL_API_KEY='<获准 Model Profile 的密钥>'
XW_STARROCKS_PASSWORD='<warehouse 只读账号密码>'
XW_ARCHIVE_STARROCKS_PASSWORD='<archive 只读账号密码>'
