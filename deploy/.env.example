# 小维的秘密和部署参数。首次安装时复制为 .env 并 chmod 600；升级不得用新模板覆盖现有 .env。
# 这里可以用 # 写注释；xiaowei.json 是标准 JSON，不能写 # 或 // 注释。
# 尖括号 <……> 是待填写标记：不替换就运行 config check，会指出是哪一项。
# 值里有空格、#、$ 或引号时用单引号包住；不要把真实值提交到 Git 或发到聊天里。

# 一、部署参数：通常不用改。改端口时，xiaowei.json 的 listen_port 要一起改。
XW_WEB_PORT=8501
# 默认内网其他电脑可以用 http://服务器IP:端口 访问；只想本机访问时去掉 # 并保持 127.0.0.1。
# XW_WEB_BIND_HOST=127.0.0.1
XW_STOP_GRACE_SECONDS=120
XW_CONFIG_FILE=./xiaowei.json
XW_CERTS_DIR=./certs
XW_LOG_MAX_SIZE=10m
XW_LOG_MAX_FILES=3
XW_PROJECT_NAME=xiaowei
XW_PG_VOLUME=xiaowei-pgdata

# 二、首次生成一次，之后长期保存。
# PostgreSQL 密码自己生成（例如 openssl rand -hex 24）；XW_DATABASE_URL 里的密码必须和它一致，
# 含特殊字符时按 URI 规则编码。数据库初始化后不要再改这三项。
XW_POSTGRES_DB=xiaowei
XW_POSTGRES_USER=xiaowei
XW_POSTGRES_PASSWORD='<生成并安全保存的 PostgreSQL 密码>'
XW_DATABASE_URL='postgresql+asyncpg://xiaowei:<URI 编码后的密码>@postgres:5432/xiaowei'
# 摘要密钥用 openssl rand -hex 32 生成。它和数据库成对备份、成对恢复；升级、重装都不能重新生成，
# 否则旧记录无法读取，服务会拒绝启动。
XW_DIGEST_KEY='<生成并安全保存的摘要密钥>'

# 三、必填：模型和第一个 StarRocks。
# 模板的模型是 Vertex：这里填 Vertex AI 的 API Key（Express Mode），由 Google Cloud 管理员提供；
# 只填 Key 本身，不填 JSON 文件或项目号。可以轮换（改完重启小维）。
XW_MODEL_API_KEY='<获准 Model Profile 的密钥>'
# StarRocks 这里只填只读账号的密码；地址、账号和默认库写在 xiaowei.json 的 targets 里。
XW_STARROCKS_PASSWORD='<warehouse 只读账号密码>'

# 四、按需：只有 xiaowei.json 实际用到时才需要。
# 按 OPERATIONS 的“增加第二个 StarRocks 目标”加了 archive 目标时，去掉下一行开头的 #，填它的只读密码。
# XW_ARCHIVE_STARROCKS_PASSWORD='<archive 只读账号密码>'
# 启用飞书时去掉下一行开头的 #，填飞书开放平台里该应用的 App Secret。
# XW_FEISHU_APP_SECRET='<飞书应用 App Secret>'
