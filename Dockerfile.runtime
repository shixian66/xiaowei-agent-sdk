# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv@sha256:4f5d923c9dcea037f57bda425dd209f3ec643da2f0b74227f68d09dab0b3bb36 AS build

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
WORKDIR /build

COPY pyproject.toml uv.lock ./
COPY src/xiaowei ./src/xiaowei

RUN uv sync --frozen --no-dev --no-install-project
RUN uv build --wheel --out-dir /tmp/dist \
    && uv pip install --python /opt/venv/bin/python --no-deps /tmp/dist/*.whl


FROM python@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b

ARG XW_CODE_SHA
LABEL org.opencontainers.image.title="xiaowei" \
      org.opencontainers.image.revision="${XW_CODE_SHA}"

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/nonexistent

COPY --from=build /opt/venv /opt/venv
COPY deploy/container_entrypoint.py /opt/xiaowei/container_entrypoint.py

USER 65532:65532
ENTRYPOINT ["python", "/opt/xiaowei/container_entrypoint.py"]
CMD ["serve"]
